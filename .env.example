REPLICATE_API_TOKEN=your_api_token

# Vercel Blob — required for the Gallery feature.
# Get this from your Vercel project dashboard → Storage → Blob → your store → .env.local
BLOB_READ_WRITE_TOKEN=your_blob_token

# Admin password for /admin — protects delete functionality.
# Use a long random value, e.g. the output of: openssl rand -base64 32
GALLERY_ADMIN_SECRET=your_admin_password

# Optional abuse limits, counted per server instance (see README > Abuse protection).
# Generations allowed per day across all visitors (default 200; 0 turns generation off).
# GENERATION_DAILY_LIMIT=200
# Gallery saves allowed per day across all visitors (default 10; 0 turns saving off).
# GALLERY_SAVE_DAILY_LIMIT=10
# Self-hosting only: the request header your reverse proxy overwrites with the
# client IP, e.g. x-real-ip. Not needed on Vercel.
# TRUSTED_IP_HEADER=x-real-ip
