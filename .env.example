REPLICATE_API_TOKEN=your_api_token

# Vercel Blob — required for the Gallery feature.
# Get this from your Vercel project dashboard → Storage → Blob → your store → .env.local
BLOB_READ_WRITE_TOKEN=your_blob_token

# Set to "true" to skip Replicate calls during local development.
# Returns a mock image after a 2s delay so all UI flows can be tested.
# Never set this in production (Vercel env vars).
REPLICATE_MOCK=false
